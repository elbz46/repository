<Window x:Class="PeriphHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PeriphHub.Core"
        xmlns:ui="clr-namespace:PeriphHub.UI"
        Title="PeriphHub" Height="820" Width="1180" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
    <Window.Resources>
        <ui:NotEmptyToVisibility x:Key="NotEmpty" />
        <ui:ProfileName x:Key="ProfileName" />
        <ui:HexToBrush x:Key="HexToBrush" />
        <ui:OnlineToOpacity x:Key="OnlineOpacity" />

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#E0524A" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Label + description on the left, control on the right -->
        <DataTemplate x:Key="SettingLabel" DataType="{x:Type core:DeviceSetting}">
            <StackPanel>
                <TextBlock Text="{Binding Label}" FontSize="14" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                           Visibility="{Binding Description, Converter={StaticResource NotEmpty}}" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:ToggleSetting}">
            <Grid Margin="0,8" IsEnabled="{Binding IsEnabled}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SettingLabel}" />
                <CheckBox Grid.Column="1" IsChecked="{Binding Value}" VerticalAlignment="Center" Margin="16,0,0,0"
                          Content="{Binding Value, Converter={x:Static ui:OnOff.Instance}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:RangeSetting}">
            <Grid Margin="0,8" IsEnabled="{Binding IsEnabled}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SettingLabel}" />
                <DockPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Right" MinWidth="86" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Run Text="{Binding Value, Mode=OneWay}" /> <Run Text="{Binding Unit, Mode=OneWay}" />
                    </TextBlock>
                    <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding SliderValue}"
                            SmallChange="{Binding Step}" LargeChange="{Binding Step}" VerticalAlignment="Center" />
                </DockPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:ChoiceSetting}">
            <Grid Margin="0,8" IsEnabled="{Binding IsEnabled}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SettingLabel}" />
                <ComboBox Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding Options}"
                          DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Value}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:TextSetting}">
            <Grid Margin="0,8" IsEnabled="{Binding IsEnabled}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SettingLabel}" />
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:InfoSetting}">
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SettingLabel}" />
                <TextBox Grid.Column="1" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent" Margin="16,0,0,0" VerticalAlignment="Center"
                         FontFamily="{Binding Id, Converter={x:Static ui:MonoForDiag.Instance}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:CommandSetting}">
            <StackPanel Margin="0,8">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SettingLabel}" />
                <ItemsControl ItemsSource="{Binding Commands}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Margin="0,0,8,8" Padding="14,6" Click="OnCommand"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:ColorSetting}">
            <Grid Margin="0,8" IsEnabled="{Binding IsEnabled}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SettingLabel}" />
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <ItemsControl ItemsSource="{x:Static core:ColorSetting.Swatches}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="30" Height="30" Margin="3" Padding="0" Click="OnSwatch" ToolTip="{Binding}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <Border Width="22" Height="22" CornerRadius="11" Background="{Binding Converter={StaticResource HexToBrush}}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="3,6,0,0">
                        <Border Width="30" Height="30" CornerRadius="6" BorderThickness="1" BorderBrush="#40808080"
                                Background="{Binding Value, Converter={StaticResource HexToBrush}}" />
                        <TextBox Width="100" Margin="8,0" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" />
                        <Button Content="More colours…" Click="OnPickColor" Tag="{Binding}" Padding="10,4" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:EqualizerSetting}">
            <StackPanel Margin="0,8">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SettingLabel}" />
                <ItemsControl ItemsSource="{Binding Bands}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="56" Margin="2,0">
                                <TextBlock Text="{Binding Gain, StringFormat={}{0:+0;-0;0} dB}" HorizontalAlignment="Center" FontSize="12" />
                                <Slider Orientation="Vertical" Height="160" HorizontalAlignment="Center" Minimum="{Binding Min}" Maximum="{Binding Max}"
                                        Value="{Binding Gain}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6" />
                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="12" Opacity="0.75" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:ButtonMapSetting}">
            <StackPanel Margin="0,8">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SettingLabel}" />
                <DockPanel Margin="0,10,0,6">
                    <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Content="Remove this app" Click="OnRemoveApp" Tag="{Binding}" Margin="8,0,0,0"
                            Visibility="{Binding CanRemoveProfile, Converter={StaticResource BoolToVis}}" />
                    <Button DockPanel.Dock="Right" Content="Add app…" Click="OnAddApp" Tag="{Binding}" Margin="8,0,0,0" />
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding CurrentProfile}" MinWidth="220" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource ProfileName}}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Buttons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:MappableButton}">
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" /><ColumnDefinition Width="300" /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" Margin="10,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock><Run Text="{Binding Label, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Category, Mode=OneWay}" Foreground="Gray" FontSize="11" /></TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Grid.Column="2" Visibility="{Binding NeedsArg, Converter={StaticResource BoolToVis}}">
                                    <TextBox Text="{Binding Arg, UpdateSourceTrigger=LostFocus}" PreviewKeyDown="OnArgKeyDown" VerticalContentAlignment="Center" />
                                    <TextBlock Text="{Binding ArgHint}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,16">
                <Image Source="Assets/app.ico" Width="28" Height="28" />
                <TextBlock Text="PeriphHub" FontSize="22" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button Click="OnRescan" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" />
                        <TextBlock Text="Rescan devices" Margin="10,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Click="OnShowSettings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" />
                        <TextBlock Text="Settings" Margin="10,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="DEVICES" FontSize="11" Opacity="0.6" Margin="10,0,0,6" />
            <ListBox x:Name="DeviceList" ItemsSource="{Binding Devices}" SelectionChanged="OnDeviceSelected"
                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:ManagedDevice}">
                        <Grid Margin="2,6" Opacity="{Binding IsOnline, Converter={StaticResource OnlineOpacity}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StatusLine}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Device page -->
        <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="8,0,24,24">
            <StackPanel Margin="12,20,0,0">
                <TextBlock x:Name="EmptyText" Text="Looking for devices… Plug in or turn on a mouse, keyboard or headset and it will appear here by itself." FontSize="15" Opacity="0.7"
                           Visibility="Collapsed" TextWrapping="Wrap" />
            <StackPanel x:Name="PageBody" DataContext="{Binding Selected}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40" VerticalAlignment="Center" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock FontSize="13" Opacity="0.7">
                            <Run Text="{Binding Vendor, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding StatusLine, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <Border Background="#22FFB900" BorderBrush="#66FFB900" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,4"
                        Visibility="{Binding Notice, Converter={StaticResource NotEmpty}}">
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
                </Border>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:SettingGroup}">
                            <StackPanel Margin="0,16,0,0">
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,8" />
                                <Border CornerRadius="8" Padding="18,8" BorderThickness="1"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <ItemsControl ItemsSource="{Binding Settings}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
